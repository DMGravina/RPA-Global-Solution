# Configurações do Robô CitizenTech RPA
ARQUIVO_ENTRADA=dados_cidadaos.csv
BANCO_SQLITE=citizentech_rpa.db
LIMIAR_CONFIANCA_IA=0.55
RESET_BANCO=true

# Configurações de E-mail (Deixe MODO_SIMULACAO_EMAIL=true para rodar sem servidor SMTP)
MODO_SIMULACAO_EMAIL=true
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=seu_email_teste@exemplo.com
SMTP_SENHA=sua_senha_de_app_aqui